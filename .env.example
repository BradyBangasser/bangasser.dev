# Optional. Both have sensible defaults — you only need this file if you
# want to change the scanned GitHub account or raise the API rate limit.

# GitHub username to scan for public repos (defaults to BradyBangasser)
GITHUB_USERNAME=BradyBangasser

# Optional personal access token (no scopes needed for public repos) —
# raises the GitHub API rate limit for the build-time scan in scripts/fetch-github.ts
# GITHUB_TOKEN=

# --- Resume AI tailoring (server-side, your key) ---
# Optional: preset downloads and in-browser compile work without these.
# Only the "tailor to a job posting" button needs them.
ANTHROPIC_API_KEY=
RESUME_AI_MODEL=claude-haiku-4-5-20251001

# GitHub OAuth gates the AI tailoring (recruiters still get all presets free)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# random string, e.g. `openssl rand -hex 32`
AUTH_SECRET=
# your GitHub login, gets the higher rate limit
RESUME_OWNER_LOGIN=BradyBangasser
